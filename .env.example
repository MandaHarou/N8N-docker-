# --- Sécurité n8n ---
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=votre_nom_utilisateur
N8N_BASIC_AUTH_PASSWORD=votre_mot_de_passe_solide
N8N_ENCRYPTION_KEY=générer_avec_openssl_rand_hex_32

# --- n8n AI Sandbox ---
N8N_SANDBOX_VERSION=1.3.4
SANDBOX_API_KEYS=générer_avec_openssl_rand_hex_32
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=générer_avec_openssl_rand_hex_32
SANDBOX_RUNNER_REGISTRATION_TOKEN=même_valeur_que_SANDBOX_API_RUNNER_REGISTRATION_TOKEN
SANDBOX_RUNNER_API_KEYS=générer_avec_openssl_rand_hex_32

N8N_SANDBOX_SERVICE_URL=http://sandbox-api:8080
N8N_SANDBOX_SERVICE_API_KEY=même_valeur_que_SANDBOX_API_KEYS

# --- SearXNG (Recherche Web AI) ---
SEARXNG_SECRET=générer_avec_openssl_rand_hex_32

# --- Identité et URLs publiques ---
N8N_HOST=votre-domaine.ngrok-free.dev
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://votre-domaine.ngrok-free.dev/

# --- CORS restreint ---
N8N_CORS_ALLOW_ORIGIN=https://votre-domaine.ngrok-free.dev
N8N_CORS_ALLOW_METHODS=GET,POST,OPTIONS
N8N_CORS_ALLOW_HEADERS=Content-Type,Authorization
